PROJECT_NAME="Testimonial & Social Proof Collector"
API_V1_STR="/api"
SECRET_KEY="your-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DATABASE_NAME="socialproof"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000","http://localhost:8000","*"]

# ── Email / SMTP Configuration (Gmail) ────────────────────────────────────────
# Requirements for Gmail SMTP Delivery:
# 1. SMTP_HOST should be smtp.gmail.com
# 2. SMTP_PORT should be 587 (TLS)
# 3. SMTP_USERNAME should be your full Gmail sender address (e.g. sender@gmail.com)
# 4. SMTP_PASSWORD must be a 16-character Google App Password (NOT your normal Gmail password)
# 5. SMTP_FROM_EMAIL should be your Gmail sender address (defaults to SMTP_USERNAME)
# 6. SMTP_FROM_NAME is the display name in the user's inbox (e.g. SocialProof)
#
# How to set up Google Security for Gmail App Passwords:
# Step A: Go to https://myaccount.google.com/security
# Step B: Turn ON 2-Step Verification (required by Google for App Passwords)
# Step C: Search for "App Passwords" or visit https://myaccount.google.com/apppasswords
# Step D: Enter App Name "SocialProof" and click "Create"
# Step E: Google will display a 16-character password (e.g. abcd efgh ijkl mnop)
# Step F: Copy this 16-character string into SMTP_PASSWORD below (spaces are fine or can be removed)
#
# Diagnostic testing tool:
# Test your configuration at any time by running:
#   python backend/scripts/test_smtp_connection.py
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SocialProof

# ── App URL & Verification Policy ─────────────────────────────────────────────
# Base URL used when building verification and reset links sent in emails
APP_BASE_URL=http://127.0.0.1:8000
# Set to true to enforce only @gmail.com accounts during registration
GMAIL_ONLY=true
